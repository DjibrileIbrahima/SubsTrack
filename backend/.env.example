# Plaid
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here
PLAID_ENV=sandbox
# Public URL Plaid sends ITEM/TRANSACTIONS webhooks to. Without it, account
# statuses (reconnect required, etc.) only update when a sync fails.
# Prod: https://yourdomain.com/api/webhooks/plaid
# PLAID_WEBHOOK_URL=
# Webhooks are verified by default; an unsigned request is rejected (401).
# Set to true ONLY for local dev with Plaid's sandbox tester (which can't sign).
# Never set this in production.
# PLAID_ALLOW_UNVERIFIED_WEBHOOKS=false

# Database
POSTGRES_PASSWORD=your_db_password_here
DATABASE_URL=postgresql+asyncpg://substrack:your_db_password_here@localhost:5432/substrack

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Dev: http://localhost:5173/api/auth/google/callback
# Prod: https://yourdomain.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Encryption of secrets at rest (Plaid tokens, MFA secrets).
#
# Production: use AWS KMS so the master key never touches the app host. Set the
# KMS key ARN/ID; the instance role needs kms:Encrypt + kms:Decrypt on it. Keep a
# Fernet key set alongside during migration so pre-KMS rows still decrypt.
# ENCRYPTION_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/abcd-...
#
# Local dev / fallback: Fernet key(s). ENCRYPTION_KEYS is comma-separated, newest
# first, for rotation; ENCRYPTION_KEY is the single-key form. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_generated_key_here
# ENCRYPTION_KEYS=new_key_here,old_key_here

# AI subscription detection — get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the model (default: llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.3-70b-versatile

# Alerts (Phase 5)
# Email — get your key at https://resend.com/api-keys
RESEND_API_KEY=your_resend_key_here
# Must be a verified sender domain in your Resend account
ALERT_FROM_EMAIL=alerts@yourdomain.com
# SMS (Phase 5 — optional)
# TWILIO_ACCOUNT_SID=your_twilio_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_token_here
# TWILIO_PHONE_NUMBER=+1234567890

#JWT Token settings
JWT_SECRET=your_jwt_secret_here
# Access token lifetime (minutes). Kept short; long sessions ride on rotating
# refresh tokens. Default: 30.
JWT_EXPIRE_MINUTES=30
# Refresh token / session lifetime (days). Default: 7.
REFRESH_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Set to false only in local dev (no HTTPS). Must be true in production.
COOKIE_SECURE=false

# Redis — used for distributed rate limiting across multiple backend instances
REDIS_URL=redis://localhost:6379

# Set to true in development to log all SQL queries (never in production)
SQL_ECHO=false

# ── Observability ────────────────────────────────────────────────────────────

# Logging format: "json" for structured output (recommended in production),
# "text" for human-readable output (default for local dev)
LOG_FORMAT=text

# Sentry exception tracking — get your DSN at https://sentry.io
# Leave unset to disable Sentry entirely
# SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# SENTRY_TRACES_SAMPLE_RATE=0.1   # 10 % of requests traced for performance monitoring
# ENV=production                   # Sentry environment tag (production / staging / development)

# OpenTelemetry distributed tracing — compatible with Grafana Cloud, Honeycomb, Jaeger, etc.
# Leave unset to disable tracing entirely
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp
# OTEL_SERVICE_NAME=substrack-backend

# Slow query threshold in milliseconds (default 200 ms)
# SLOW_QUERY_MS=200
