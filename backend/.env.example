# Plaid
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here
PLAID_ENV=sandbox

# Database
DATABASE_URL=postgresql+asyncpg://substrack:substrack_password@localhost:5432/substrack

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=your_google_redirect_uri_here

# Encryption — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_generated_key_here

# Alerts (added in Phase 5)
# RESEND_API_KEY=your_resend_key_here
# TWILIO_ACCOUNT_SID=your_twilio_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_token_here
# TWILIO_PHONE_NUMBER=+1234567890

#JWT Token settings
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE_MINUTES=10080 # 7 days in minutes

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Set to true in development to log all SQL queries (never in production)
SQL_ECHO=false
