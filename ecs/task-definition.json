{
  "family": "substrack-app",
  "networkMode": "host",
  "requiresCompatibilities": ["EC2"],
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/substrack-backend:latest",
      "essential": true,
      "environment": [
        { "name": "PLAID_ENV",     "value": "production" },
        { "name": "COOKIE_SECURE", "value": "true" },
        { "name": "SQL_ECHO",      "value": "false" }
      ],
      "secrets": [
        { "name": "DATABASE_URL",          "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/substrack/DATABASE_URL" },
        { "name": "REDIS_URL",             "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/substrack/REDIS_URL" },
        { "name": "JWT_SECRET",            "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/substrack/JWT_SECRET" },
        { "name": "ENCRYPTION_KEY",        "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/substrack/ENCRYPTION_KEY" },
        { "name": "PLAID_CLIENT_ID",       "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/substrack/PLAID_CLIENT_ID" },
        { "name": "PLAID_SECRET",          "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/substrack/PLAID_SECRET" },
        { "name": "GOOGLE_CLIENT_ID",      "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/substrack/GOOGLE_CLIENT_ID" },
        { "name": "GOOGLE_CLIENT_SECRET",  "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/substrack/GOOGLE_CLIENT_SECRET" },
        { "name": "GOOGLE_REDIRECT_URI",   "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/substrack/GOOGLE_REDIRECT_URI" },
        { "name": "RESEND_API_KEY",        "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/substrack/RESEND_API_KEY" },
        { "name": "ALERT_FROM_EMAIL",      "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/substrack/ALERT_FROM_EMAIL" },
        { "name": "FRONTEND_URL",          "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/substrack/FRONTEND_URL" },
        { "name": "CORS_ORIGINS",          "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/substrack/CORS_ORIGINS" },
        { "name": "GROQ_API_KEY",          "valueFrom": "arn:aws:ssm:<AWS_REGION>:<AWS_ACCOUNT_ID>:parameter/substrack/GROQ_API_KEY" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/substrack",
          "awslogs-region":        "<AWS_REGION>",
          "awslogs-stream-prefix": "backend"
        }
      }
    },
    {
      "name": "frontend",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/substrack-frontend:latest",
      "essential": true,
      "dependsOn": [{ "containerName": "backend", "condition": "START" }],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/substrack",
          "awslogs-region":        "<AWS_REGION>",
          "awslogs-stream-prefix": "frontend"
        }
      }
    }
  ]
}
